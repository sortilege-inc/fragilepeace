EXTENSION "FragilePeace_Cast" {
    NAME "The Fragile Peace — the cast"
    VERSION "0.1.1"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-26"
    DEPENDS_ON "L5R5e_Core_Core"

    # The cast: instances of the Samurai ACTOR in the corpus's pregen conventions. Converted from
    # campaign/source/foundry/ (the Foundry exports, byte for byte) by campaign/source/convert_pcs.py;
    # campaign/source/check_pcs.py reads the built layer back against them field by field.

    # The current sheet: foundry/fvtt-Actor-doji-setsuna.json.
    #FPpcDojiSetsuna ^"Doji Setsuna" DEF {
        EXTENDS #L5R003xY4zA6bC8dE0fG2hI ^"Samurai"
        PROPERTIES {
            ^"Name" STRING "Doji Setsuna" FIXED
            ^"Clan" STRING "Crane" FIXED
            ^"Family" STRING "Doji" FIXED
            ^"School" STRING "Doji Bureaucrat"
            ^"School Rank" INTEGER 3
            ^"Roles" LIST OF STRING ["Courtier"]
            ^"Rings" DEF { ^"Air" INTEGER 3 ^"Earth" INTEGER 3 ^"Fire" INTEGER 2 ^"Water" INTEGER 3 ^"Void" INTEGER 2 }
            ^"Honor" INTEGER 69
            ^"Glory" INTEGER 71
            ^"Status" INTEGER 60
            ^"Endurance" INTEGER 10
            ^"Composure" INTEGER 12
            ^"Focus" INTEGER 5
            ^"Vigilance" INTEGER 3
            ^"Void Points" INTEGER 2
            ^"Ninjō" STRING "Strictures too often interfere with a beautiful tale.\n\nShe escapes into literature, particularly pillow-books, and riding her horse, Kogarashi, a Utaku steed and wedding gift from her husband's family."
            ^"Giri" STRING "Currently, Kitsuki Kāgi, in service as an Emerald Magistrate under the Emperor.\n\nPreviously, she served Asahina Shigehiro, lord of the city of Shirogome, on issues of imperial law and legal arbitration.\n\nHer giri: Rule must bind, and if needed, contort."
            ^"Skills" LIST OF STRING ["Composition 2", "Design 2", "Fitness 1", "Martial Arts [Unarmed] 3", "Culture 2", "Government 3", "Sentiment 2", "Command 3", "Courtesy 3", "Performance 1", "Commerce 1"]
            ^"Techniques" LIST OF #L5R350fG9hI1jK3lM5nO7p ^"Technique" [#kcz9tYqb7ZkxEjkD96CUXF ^"Courtier's Resolve", #n1bPScWFDIHIP8vDn1nCBD ^"Stonewall Tactics", #NHSvf55MvHC872WUw9laYv ^"Beware the Smallest Mouse", #HqWk8bnWA0tB1rZgr0Ru1f ^"Treaty Signing", #YRrwJlgAyPpVIMmg9hKPC4 ^"Civility Foremost", #svvmtBGYb5XXrrqx9aY0hD ^"Well of Desire", #9joMTiwaMNeSp95EKmWY6s ^"The Wind Blows Both Ways", #l2wYxPgu8jTyj5EdSlvmOM ^"Crescent Moon Style", #i05F04V9dqXMYX8JbjixhJ ^"Coiling Serpent Style", #zVzvM0KFizf2Zk0Dl66npx ^"Open-Hand Style", #8Yh77FWi4wCMphnZVYwU30 ^"Shallow Waters", #FI4nQQ3pXWkloDjbYP6e6w ^"Call to Ride", #ptNdPtiPE6nxbxWJzsFBAe ^"Hidden in Smoke"]
            ^"Advantages" LIST OF #L5R263hI5jK7lM9nO1pQ3r ^"Advantage" [#k6iLCNkoKlSSE9s8S4yNxI ^"Wordplay", #esSp6Eof1QH3kxH40Z7DB7 ^"Blessed Lineage", #sAJjgAk4AYKKWv62goQTpF ^"Paragon of a Bushidō Tenet", #TgTnBnqZtHhNPTHTtfP8Ul ^"Famously Successful", #Yh2FO13lb5Hhsp27DHIPaf ^"Legal Scholarship", #sAJjgAk4AYKKWv62goQTpF ^"Paragon of a Bushidō Tenet"]
            ^"Disadvantages" LIST OF #L5R264sT6uV8wX0yZ2aB4c ^"Disadvantage" [#De0xOyZvPCpMxKmEu43H7M ^"Scorn of [One Group]", #ck5C2s1z0QzPvtY5f3zH8d ^"Fear of Death", #varuU3zrlVDHkMrUhqq4xt ^"Haunting", #AVhLvrn9JkweqLTdUEw5Xd ^"Dark Secret"]
            ^"Titles" LIST OF #L5R463nO5pQ7rS9tU1vW3x ^"Title" [#te00d8a952f43f435d9017 ^"Emerald Magistrate", #9CQXynRmsZhECY4Lgu5sWP ^"Advisor"]
            ^"Bonds" LIST OF #L5R262wX4yZ6aB8cD0eF2g ^"Bond" [#CyrnYiMyZEIYWW6UWAi5LT ^"Lover Bond"]
            ^"Equipment" LIST OF STRING ["Ceremonial Clothes", "Calligraphy Set", "Wakizashi", "Personal Seal or Chop", "Blank Forms", "Legal Primer", "Hano no Ami Pillow Book", "Scroll of Authority from Magistrate of Shirogome", "400 zeni"]
            ^"Bushido" DEF { ^"Paramount Tenet" STRING "Courtesy" ^"Less Significant Tenet" STRING "Courage" }
            ^"Experience" INTEGER 103
            ^"Experience Spent" INTEGER 98
            ^"Experience Ledger" LIST OF STRING ["4 · Government +1 (1 -> 2) · rank 1", "6 · Government +1 (2 -> 3) · rank 1", "3 · Beware The Smallest Mouse · rank 1", "3 · Treaty Signing · rank 1", "4 · Sentiment +1 (1 -> 2) · rank 1", "6 · Fire +1 (1 -> 2) · rank 2", "6 · Void +1 (1 -> 2) · rank 2", "3 · Civility Foremost · rank 2", "3 · Well of Desire · rank 2", "3 · The Wind Blows Both Ways · rank 2", "30 · Emerald Magistrate · rank 2", "6 · Courtesy +1 (2 -> 3) · rank 2", "3 · Call to Ride · rank 2", "3 · Hidden in Smoke · rank 3", "9 · Personal Advisor to Miya Misato · rank 3", "6 · Command +1 (2 -> 3) · rank 3"]
            ^"Stance" STRING "Air"
            ^"Description" STRING "Doji Setsuna is a Crane noblewoman of Imperial Bloodline, Emerald Magistrate, and Personal Advisor to the Imperial Envoy — a lawyer trained to wield the law as a blade and a courtier who has built her interior architecture around the institutional doctrine that visibility, when properly deployed, is the surest armor.\nShe is in her mid-twenties — slight of build at about 5'4\", finely-boned with soft hands, light skin warmed by an undertone of gold, and dark brown eyes set in a composed face. Her long black hair is worn in a high, elegant bun from which a few strands always escape — the one persistent imperfection in an otherwise immaculate presentation. She carries herself with a tall, deliberate poise that makes her seem larger than her frame, and her dress is consistently the finest in any party she travels with: refined Crane silks in pale blue and white, often with gold detailing, cut and worn to suggest understated harmlessness rather than display. Her station speaks for her; she does not need to."
            ^"Notes" STRING "Kogarashi is a white Utaku steed with a silver mane and tail — lean, swift, and always poised. She was a wedding gift from the Shinjō family and is the one being in Setsuna's life to whom warmth flows without mediation. Ridden equally for pleasure and for political effect, Kogarashi's distinctive Utaku breeding marks Setsuna at distance to any Unicorn who sees her.\nSetsuna currently serves Imperial Envoy Miya Misato as her Personal Advisor. Her giri is to see Misato succeed in brokering a peace between the Lion and the Unicorn. Her ninjō is to innovate the trilateral agreement for Toshi Ranbo — for the Crane clan, for her grandmother, and to see to her husband's freedom.\nHousehold\nAika — Personal attendant. Former geisha, now in Setsuna's intimate care. Manages hair, dress, and the chamber. Geisha-trained discretion. One of the two senior women of the household.Ishika — Lady's maid and personal attendant. Quiet, middle-aged, motherly. Carries the maternal-continuity register of the household. The second of the two senior women.Otoya — Scribe and legal assistant. A Crane man with encyclopedic knowledge of Imperial law. Setsuna's working partner for document preparation and legal research.Jiro — Horse attendant. A Unicorn, responsible for the care of Kogarashi.Bayushi Monbon — Yojimbo. A Scorpion samurai assigned to Setsuna as punishment duty by his lord, originally without the right of seppuku. Fired by Setsuna at the Ifrit incident and reclaimed at the Midnight Treaty; his ransom was invoiced back to his lord. Currently in functional partnership with her. Carries a bound Lady of Decay that has been growing in visibility.Family\nDoji Masateru — Father. Imperial legal scholar, well-versed and emotionally distant. Taught her to wield the law like a sword: a single correct argument, like a single cut, should be fatal.Doji Ayaka — Mother. Arranged her marriage to Harunobu. A year later, advised obliquely that a daughter of the Doji turns infidelities into poetry.Doji Retsuo — Older brother. The model heir. Thinks she is too verbose.Doji Emika — Younger sister. Sees Setsuna as a woman trapped by duty, but keeps her thoughts private. Has no desire to follow in her footsteps. Reserved in Setsuna's plans for the Toshi Ranbo settlement, to marry into the Matsu family and satisfy the grandmother's restoration demand.Matsu Tomoe — Late maternal grandmother. Married into the Crane from the Matsu and hated being a Crane for the rest of her life. Now haunts Setsuna as a ghost, demanding the restoration of Toshi Ranbo and the Matsu lineage.Marriage\nShinjō Harunobu — Husband. A respected Shinjō commander, currently a Lion prisoner of war. Loves her and respects her intellect, though he considers her work legal trickery and prefers to solve problems directly. He understands he has married up. They communicate by letter; the marriage has been long-distance for years.Mentors and Superiors\nBayushi Tomono — Scorpion courtier she encountered in Shirogome. Engaged her in wordplay and taught her how to exploit Imperial law and weaponize harmlessness. One of three people whose approval she cares about.Asahina Shigehiro — Her former lord, Crane shugenja and ruler of the city of Shirogome. Employed her as legal counsel on matters of Imperial law. One of three whose approval matters.Kitsuki Kāgi — Her Emerald Magistrate superior. Recruited her into Imperial service after the Kakita tax loophole brought her to his attention. One of three whose approval matters.Magistrate Colleagues\nKakita Kazumi — Kakita duelist, Topaz Champion, and trained Crane Harrier (shinobi) operating in plain sight. Has consistently shown her discretion and quiet loyalty, including providing logistical support during the abortion procedure.Shiba Midori — Phoenix shugenja. Brewed the abortifacient and conducted the procedure. The sole peer-level intimate with whom Setsuna has been visibly unmasked. Her shugenja presence first allowed the grandmother's ghost to manifest.Lord\nMiya Misato — Imperial Envoy, sixteen years old. Originally dispatched on a mission designed to fail. Setsuna appointed herself as her advisor and has invested her own XP transferring skills to her. Nearly assassinated and now blind, but alive. The displaced object of the motherhood Setsuna refused, and simultaneously her operational frame and political instrument.Adversary\nKakita Noritomo — The Kakita provincial daimyō whose new artisan tax Setsuna voided through an Imperial precedent during her time in Shirogome. He banned her from his lands rather than risk a contest he would lose; the institutional grudge remains active in the Kakita family.The Lover At Court\nAn unnamed member of an Imperial family in Otosan Uchi. Father of the pregnancy Setsuna conceived approximately four months before her departure for Loyalty Castle. He does not know she was pregnant and has never known. Setsuna does not pursue contact."
            ^"As Recorded" LIST OF STRING ["Scorn of Kakita", "Paragon of Courtesy", "Beware The Smallest Mouse", "Paragon of Courage", "Shinjō Harunobu", "Personal Advisor to Miya Misato"]
            ^"Afflictions" LIST OF STRING ["Void Wound — severe, partially healed: Sustained during the termination. Increases the TN of Void-stance and Void-skill checks rather than reducing pool capacity. It has persisted across the whole arc of the campaign and does not clear on a scene reset."]
            ^"Bushido Register" STRING "Rigid acquiescence"
            ^"Mounts" LIST OF STRING ["Kogarashi: A white Utaku steed with a silver mane and tail — lean, swift, always poised. A wedding gift from the Shinjō family, and the one being to whom her warmth flows unmediated. Her distinctive Utaku breeding marks Setsuna at distance to any Unicorn who sees her."]
            ^"In Hand, Unspent" LIST OF STRING ["Two boons, owed by the Lion. Unspent and unspecified, taken in the tent at session 53 when they were left choosing between giving ground and owing her.", "Next Social skill check against Miya Satoshi: TN −4, to a minimum of TN 1. Worth spending on a Social (Water) check so Shallow Waters can buy his ninjō at two opportunities."]
        }
    }

