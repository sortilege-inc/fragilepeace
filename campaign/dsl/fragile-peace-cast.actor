            ^"Disadvantages" LIST OF #L5R264sT6uV8wX0yZ2aB4c ^"Disadvantage" [#8ZxjI2CjzD73Z0uR5sgrpd ^"Fukurokujin's Curse", #BkrSj7NWJDQh8Vl7EXFavH ^"Belligerent", #cIjK5KIAsniJIzD7ml1Thp ^"Superstition"]
